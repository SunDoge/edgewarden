{
	"name": "edgewarden",
	"version": "1.0.0",
	"private": true,
	"description": "",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"rpc:types": "bun run --filter @edgewarden/api rpc:types",
		"dev": "bun run --parallel --filter './apps/*' dev",
		"build": "bun run --filter @edgewarden/web build",
		"deploy": "bun run build && bun run --filter @edgewarden/api deploy",
		"test": "bun run --parallel --filter './apps/*' --if-present test",
		"check": "bun run --parallel --filter './apps/*' --if-present check",
		"lint": "biome lint .",
		"format": "biome format --write ."
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.14"
	},
	"trustedDependencies": [
		"@tailwindcss/oxide",
		"esbuild",
		"sharp",
		"workerd"
	],
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^2.5.0"
	},
	"dependencies": {
		"fflate": "^0.8.3"
	}
}
