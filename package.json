{
	"name": "edgewarden",
	"version": "1.0.0",
	"private": true,
	"description": "A Bitwarden-compatible password manager for Cloudflare Workers",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"rpc:types": "bun run --filter @edgewarden/api rpc:types",
		"dev": "bun run --parallel --filter './apps/*' dev",
		"build": "bun run --filter @edgewarden/web build",
		"db:migrate:local": "bun run --filter @edgewarden/api db:apply:local",
		"db:migrate:remote": "bun run --filter @edgewarden/api db:apply:remote",
		"db:migrate:remote:kv": "bun run --filter @edgewarden/api db:apply:remote:kv",
		"deploy": "bun run db:migrate:remote && bun run --filter @edgewarden/api deploy",
		"deploy:kv": "bun run db:migrate:remote:kv && bun run --filter @edgewarden/api deploy:kv",
		"test": "bun run --parallel --filter './apps/*' --if-present test",
		"test:compat:bw": "bun scripts/bw-compat-smoke.ts",
		"test:integration:cloudflare": "bun scripts/cloudflare-integration-smoke.ts",
		"domains:sync": "bun scripts/sync-bitwarden-domains.ts",
		"check": "bun run --parallel --filter './apps/*' --if-present check && bun scripts/check-cloudflare-config.ts",
		"lint": "biome lint .",
		"format": "biome format --write ."
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.14"
	},
	"trustedDependencies": [
		"@tailwindcss/oxide",
		"esbuild",
		"sharp",
		"workerd"
	],
	"type": "module",
	"cloudflare": {
		"bindings": {
			"JWT_SECRET": {
				"description": "用于签名登录和短期令牌。请生成独立的随机值，例如 `openssl rand -hex 32`。"
			},
			"DATA_ENCRYPTION_SECRET": {
				"description": "用于加密持久化配置。必须独立生成并安全备份，例如 `openssl rand -hex 32`。"
			},
			"BOOTSTRAP_SECRET": {
				"description": "首次创建管理员账户时输入的部署密码。请使用高强度随机值。"
			}
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0"
	},
	"dependencies": {
		"fflate": "^0.8.3"
	}
}
