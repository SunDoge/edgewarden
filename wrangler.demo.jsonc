{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgewarden-demo",
  "main": "apps/api/src/demo/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "dev": { "port": 8788, "inspector_port": 9230 },
  "assets": {
    "directory": "apps/web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgewarden-demo-db",
      "migrations_dir": "apps/api/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS_R2",
      "bucket_name": "edgewarden-demo-attachments"
    }
  ],
  "secrets": {
    "required": ["JWT_SECRET", "DATA_ENCRYPTION_SECRET", "BOOTSTRAP_SECRET"]
  },
  "vars": {
    "ATTACHMENT_STORAGE": "r2",
    "SIGNUPS_ALLOWED": "false",
    "INVITATIONS_ALLOWED": "true",
    "DEMO_MODE": "readonly"
  },
  "durable_objects": {
    "bindings": [{ "name": "REALTIME", "class_name": "VaultRealtime" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VaultRealtime"] }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "ratelimits": [
    {
      "name": "RL_IP",
      "namespace_id": "11",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RL_ACCOUNT",
      "namespace_id": "12",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
}
