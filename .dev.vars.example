# Local development only; this file does not configure production secrets.
# Copy to .dev.vars. Never commit filled values or reuse production secrets.
# All three values below are required. Run openssl rand -hex 32 three times.
# JWT_SECRET signs tokens; DATA_ENCRYPTION_SECRET protects stored server settings.
JWT_SECRET=
DATA_ENCRYPTION_SECRET=

# Enter this value once when creating the first administrator account.
BOOTSTRAP_SECRET=

# Optional Bitwarden mobile Push Relay. Both credentials are required.
# PUSH_INSTALLATION_ID=
# PUSH_INSTALLATION_KEY=
# PUSH_REGION=US

# Optional Cloudflare Turnstile protection for login and registration.
# Configure the matching public TURNSTILE_SITE_KEY as well.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# Optional YubiKey OTP validation credentials (not needed for WebAuthn).
# YUBICO_CLIENT_ID=
# YUBICO_SECRET_KEY=
