{
	"name": "@edgewarden/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"predev": "pnpm --filter @edgewarden/api run rpc:types",
		"dev": "vite dev",
		"prebuild": "pnpm --filter @edgewarden/api run rpc:types",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "pnpm --filter @edgewarden/api run rpc:types",
