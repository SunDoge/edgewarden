{
  "name": "@edgewarden/web",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage baseLocale --emit-ts-declarations --silent",
    "predev": "pnpm --filter @edgewarden/api run rpc:types && pnpm run i18n:compile",
    "dev": "vite dev",
    "prebuild": "pnpm --filter @edgewarden/api run rpc:types && pnpm run i18n:compile",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "pnpm run i18n:compile && svelte-kit sync",
    "precheck": "pnpm --filter @edgewarden/api run rpc:types && pnpm run i18n:compile",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "pretest": "pnpm --filter @edgewarden/api run rpc:types && pnpm run i18n:compile",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@inlang/paraglide-js": "^2.29.1",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.61.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/papaparse": "^5.5.2",
    "bits-ui": "^2.20.1",
    "clsx": "^2.1.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@edgewarden/api": "workspace:*",
    "@edgewarden/shared": "workspace:*",
    "@wordlist/english-eff": "1.0.1",
    "dexie": "^4.4.6",
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.13",
    "minisearch": "^7.2.0",
    "otpauth": "^9.5.2",
    "papaparse": "^5.7.0",
    "qr-scanner": "^1.4.2",
    "ts-pattern": "^5.9.2",
    "valibot": "^1.5.0"
  }
}
