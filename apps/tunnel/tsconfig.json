{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"lib": ["ESNext", "WebWorker"],
		"types": ["./worker-configuration.d.ts"]
	},
	"include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
