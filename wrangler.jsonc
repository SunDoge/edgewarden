{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "edgewarden",
	"main": "apps/api/src/index.ts",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat"],
	"dev": {
		"port": 8787,
		"inspector_port": 9229
	},
	"assets": {
		"directory": "apps/web/build",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "edgewarden-db",
			"migrations_dir": "apps/api/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS_R2",
			"bucket_name": "edgewarden-attachments"
		}
	],
	"secrets": {
		"required": ["JWT_SECRET", "DATA_ENCRYPTION_SECRET", "BOOTSTRAP_SECRET"]
	},
	"vars": {
		"ATTACHMENT_STORAGE": "r2",
		"SIGNUPS_ALLOWED": "false",
		"INVITATIONS_ALLOWED": "true"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "REALTIME",
				"class_name": "VaultRealtime"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["VaultRealtime"]
		}
	],
	"triggers": {
		"crons": ["17 * * * *"]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	},
	"ratelimits": [
		{
			"name": "RL_IP",
			"namespace_id": "1",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "RL_ACCOUNT",
			"namespace_id": "2",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	]
}
